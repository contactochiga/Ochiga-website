# ============================================================
# SITE
# ============================================================
NEXT_PUBLIC_SITE_URL=https://ochiga.com.ng
NEXT_PUBLIC_OYI_SITE_URL=https://getoyi.com

# ============================================================
# SANITY CMS (Insights)
# Project ID below matches the existing Studio config
# (sanity.config.ts). Override per environment if needed.
# ============================================================
NEXT_PUBLIC_SANITY_PROJECT_ID=ap1ku6sf
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
SANITY_API_READ_TOKEN=
# Set to "true" once the Sanity project has real Insights content.
# Until then the site falls back to the bundled starter content in
# lib/papers.ts / lib/insights.ts (see lib/content.ts) so the
# Insights section is never empty.
NEXT_PUBLIC_SANITY_ENABLE=false

# ============================================================
# LEAD SYSTEM (Phase 3) — app/api/leads/route.ts
# Covers LAND_JV, OYI_DEPLOYMENT, PRIVATE_MEMBERSHIP,
# STRATEGIC_PARTNER, GENERAL_CONTACT.
# ============================================================
OCHIGA_LEAD_RATE_WINDOW_MS=600000
OCHIGA_LEAD_RATE_MAX=5
OCHIGA_LEAD_MIN_FORM_AGE_MS=1500
OCHIGA_LEAD_MAX_BODY_BYTES=16000
# Local JSONL fallback — DEV CONVENIENCE ONLY. Disabled in production
# unless explicitly set to "true" (not recommended — see README/
# Phase 3 report on serverless filesystem limitations; use a real
# store such as Supabase before relying on this in production).
OCHIGA_LEAD_LOCAL_FALLBACK=true
OCHIGA_LEAD_LOCAL_STORE=data/leads.jsonl

# ============================================================
# LEGACY DEPLOYMENT-REQUEST PIPELINE (app/api/deployments/route.ts)
# Predates the Phase 3 lead system and is NOT one of the five lead
# types above. Retained as-is, not linked from primary navigation.
# ============================================================
OCHIGA_DEPLOYMENT_LEAD_ENDPOINT=
OCHIGA_DEPLOYMENT_LEAD_TOKEN=
OCHIGA_DEPLOYMENT_WEBHOOK_URL=
OCHIGA_DEPLOYMENT_WEBHOOK_SECRET=
OCHIGA_DEPLOYMENT_RATE_WINDOW_MS=600000
OCHIGA_DEPLOYMENT_RATE_MAX=5
OCHIGA_DEPLOYMENT_MIN_FORM_AGE_MS=1500
OCHIGA_DEPLOYMENT_LOCAL_FALLBACK=true
OCHIGA_DEPLOYMENT_LOCAL_STORE=data/deployment-requests.jsonl
OCHIGA_DEPLOYMENT_MAX_BODY_BYTES=12000

# ============================================================
# OMA (corporate concierge widget)
# Preserved from the existing implementation pending its
# dedicated rework. See Phase 1/3 reports for audit findings.
# ============================================================
NEXT_PUBLIC_OCHIGA_WIDGET_URL=
NEXT_PUBLIC_OCHIGA_WIDGET_API_BASE=
OCHIGA_DEPLOYMENT_AGENT_BASE=
OCHIGA_DEPLOYMENT_AGENT_ENDPOINT=
OCHIGA_DEPLOYMENT_AGENT_FALLBACK=

# ============================================================
# EMAIL (Resend) — WIRED UP in Phase 3, activated in Phase 4
# (lib/email.ts, app/api/leads/route.ts). Sends two emails per lead:
# an internal notification to OCHIGA_EMAIL_OFFICE (reply-to the
# submitter), and an acknowledgement to the submitter. All five lead
# types (LAND_JV, OYI_DEPLOYMENT, PRIVATE_MEMBERSHIP, STRATEGIC_PARTNER,
# GENERAL_CONTACT) route to the same office inbox — there is no
# per-department split. Fails clearly (no silent success) if
# RESEND_API_KEY is missing in production.
#
# DO NOT DEPLOY TO PRODUCTION until:
#   - RESEND_API_KEY is a real, valid key
#   - The sending domain for EMAIL_FROM is verified in Resend (SPF/DKIM)
#   - OCHIGA_EMAIL_OFFICE actually exists and is monitored
# ============================================================
RESEND_API_KEY=
EMAIL_FROM=Ochiga <notifications@ochiga.com.ng>
OCHIGA_EMAIL_OFFICE=office@ochiga.com.ng
